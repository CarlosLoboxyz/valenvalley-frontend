# ScrapingBee credentials & request behavior
SCRAPINGBEE_API_KEY=your_api_key_here
SCRAPINGBEE_URL=https://app.scrapingbee.com/api/v1/
ALIBABA_SEARCH_URL=https://www.alibaba.com/trade/search
SCRAPINGBEE_WAIT_MS=3000
SCRAPINGBEE_TIMEOUT=90
SCRAPINGBEE_STEALTH_PROXY=false
MAX_PRODUCTS_PER_PAGE=15
DEFAULT_PAGES=1
REQUEST_DELAY_SECONDS=1.0
DEBUG_DIR=debug_raw

# Pipeline & grouping defaults
RFQ_EXCEL_FILE=products.xlsx
FAMILY_GRANULARITY=balanced
RECOMMEND_TOP_N=5

# Client filters & scoring weights
CLIENT_REQUIRED_CERTS=
CLIENT_MIN_YEARS=0
CLIENT_REQUIRE_TRADE_ASSURANCE=false
CLIENT_STRICT_MOQ=false
CLIENT_STRICT_CERTS=false
STRICT_MIN_PRICE=false
WEIGHT_PRICE=30
WEIGHT_MOQ=20
WEIGHT_TRADE_ASSURANCE=20
WEIGHT_YEARS=15
WEIGHT_CERTS=15
WEIGHT_VENDOR_SCORE=75
WEIGHT_RFQ_FIT=25

# ======================================================================
# Backend FastAPI (valenvalley-alibaba) — servidor local
# ======================================================================
# Base del API sin '/api/v1' (p. ej. http://localhost:8000).
# Si está vacía, la app usa los datos de demostración locales (con un aviso visible).
BACKEND_URL=
# El backend exige un token de PocketBase: se usa el del usuario en sesión (cookie httpOnly),
# ya no existe un token estático.
# Timeout por llamada al backend en milisegundos (por defecto 8000).
BACKEND_TIMEOUT_MS=8000

# ======================================================================
# PocketBase (autenticación) — el login ocurre en el servidor de SvelteKit
# ======================================================================
# URL de PocketBase accesible DESDE ESTE SERVIDOR (no desde el navegador).
# Con el docker-compose del monorepo: http://pocketbase:8090
POCKETBASE_URL=http://localhost:8090
# Colección de usuarios y timeout por llamada (ms).
POCKETBASE_USERS_COLLECTION=users
POCKETBASE_TIMEOUT_MS=8000
# false = oculta /signup (sólo entran usuarios creados desde el admin de PocketBase).
SIGNUP_ENABLED=true

# ======================================================================
# Servidor Node (adapter-node) — sólo producción / contenedor
# ======================================================================
# ORIGIN debe ser la URL pública (p. ej. https://app.example.com) si hay un proxy delante;
# SvelteKit lo usa para la protección CSRF de los formularios y para marcar la cookie como Secure.
# ORIGIN=
# PORT=3000
